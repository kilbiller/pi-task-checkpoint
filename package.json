{
  "name": "pi-task-checkpoint",
  "version": "0.1.0",
  "description": "Durable task checkpoints and bounded continuation for Pi with local models and limited context",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/state.test.js",
    "check": "node --check index.js && node --check extension.js && node --check core.js && npm test"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "extension.js",
    "core.js",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "checkpoints",
    "local-llm",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilbiller/pi-task-checkpoint.git"
  },
  "homepage": "https://github.com/kilbiller/pi-task-checkpoint#readme",
  "bugs": {
    "url": "https://github.com/kilbiller/pi-task-checkpoint/issues"
  }
}
